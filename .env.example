LEGINOVA_CONTAINER_NAME=leginova-mcp

# Host address and port the container is published on.
LEGINOVA_BIND=127.0.0.1
LEGINOVA_PORT=3000

# Host names clients use to reach the server, comma-separated. Add the bind
# address when clients connect to it directly rather than through a proxy.
MCP_ALLOWED_HOSTS=leginova-mcp.example.nc

# Origin host names accepted from browsers, defaults to MCP_ALLOWED_HOSTS.
# MCP_ALLOWED_ORIGINS=
